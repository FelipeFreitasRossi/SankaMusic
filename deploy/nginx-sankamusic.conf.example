# Exemplo de configuração NGINX para VPS Linux (Ubuntu/Debian)
# Frontend estático + API FastAPI (uvicorn) no mesmo domínio.
# Copie para /etc/nginx/sites-available/sankamusic e ajuste domínio/caminhos.
# Depois: sudo ln -s ../sites-available/sankamusic /etc/nginx/sites-enabled/ && sudo nginx -t && sudo systemctl reload nginx
# HTTPS: sudo certbot --nginx -d seudominio.com.br -d www.seudominio.com.br

limit_req_zone $binary_remote_addr zone=sanka_api:10m rate=20r/s;

server {
    listen 80;
    server_name seudominio.com.br www.seudominio.com.br;

    root /var/www/sankamusic/frontend/dist;
    index index.html;
    client_max_body_size 6m;   # um pouco acima de MAX_UPLOAD_MB

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # API FastAPI
    location /api/ {
        limit_req zone=sanka_api burst=40 nodelay;
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Imagens enviadas pelo painel (STORAGE_BACKEND=local)
    location /media/ {
        alias /var/www/sankamusic/backend/uploads/;
        expires 30d;
        add_header X-Content-Type-Options nosniff;
    }

    # Arquivos com hash do Vite
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA: React Router
    location / {
        try_files $uri $uri/ /index.html;
    }
}
