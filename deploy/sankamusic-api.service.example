# Serviço systemd para a API em VPS Linux.
# Copie para /etc/systemd/system/sankamusic-api.service e ajuste caminhos/usuário.
# sudo systemctl daemon-reload && sudo systemctl enable --now sankamusic-api
# Logs: journalctl -u sankamusic-api -f

[Unit]
Description=Sanka Music API (FastAPI/uvicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/sankamusic/backend
EnvironmentFile=/var/www/sankamusic/backend/.env
ExecStart=/var/www/sankamusic/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
