# =====================================================================
# Sanka Music — variáveis de ambiente do BACKEND
# Copie para ".env" e preencha. NUNCA versione o arquivo .env.
# =====================================================================

# development | production
APP_ENV=development
APP_NAME=Sanka Music API
DEBUG=true

# --- MongoDB Atlas -----------------------------------------------------
# Atlas > Database > Connect > Drivers > copie a connection string
MONGODB_URI=mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sanka_music

# --- Segurança / JWT ----------------------------------------------------
# Gere com:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
PASSWORD_RESET_EXPIRE_MINUTES=30

# --- CORS ---------------------------------------------------------------
# Lista separada por vírgulas com as origens do frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URL pública do frontend (usada em links de e-mail e retorno do pagamento)
FRONTEND_URL=http://localhost:5173
# URL pública desta API (usada no webhook do Mercado Pago)
API_PUBLIC_URL=http://localhost:8000

# Prefixo das rotas. Em hospedagem compartilhada em subpasta use, por ex., /api
API_PREFIX=/api

# --- Uploads de imagens -----------------------------------------------
# local: salva em UPLOAD_DIR e serve em /media
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MEDIA_BASE_URL=http://localhost:8000/media
MAX_UPLOAD_MB=5

# --- Regras comerciais (CONFIGURE com os valores reais da loja) --------
# Parcelamento máximo sem juros exibido nos produtos (0 = não exibir)
MAX_INSTALLMENTS=10
MIN_INSTALLMENT_VALUE=50
# Frete grátis a partir de (0 = desativado)
FREE_SHIPPING_THRESHOLD=0
# CEP de origem dos envios
STORE_ORIGIN_CEP=01001000
LOW_STOCK_THRESHOLD=5

# --- Mercado Pago (opcional — sem isso o pagamento fica indisponível) ---
# Painel do desenvolvedor: https://www.mercadopago.com.br/developers/panel
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# --- E-mail (opcional — sem isso os links são registrados no log) -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sanka Music <nao-responda@seudominio.com.br>
SMTP_TLS=true

# --- Logs ---------------------------------------------------------------
LOG_LEVEL=INFO
