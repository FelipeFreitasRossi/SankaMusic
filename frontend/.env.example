# =====================================================================
# Sanka Music — variáveis do FRONTEND (Vite)
# Copie para ".env" (desenvolvimento) ou ".env.production" (build).
# ATENÇÃO: tudo que começa com VITE_ vai para o navegador. NUNCA coloque
# chaves secretas aqui (tokens do Mercado Pago, senhas, JWT_SECRET...).
# =====================================================================

# URL da API. Em desenvolvimento deixe "/api" (o Vite faz proxy p/ localhost:8000).
# Em produção, ex.: https://api.seudominio.com.br/api  ou  https://seudominio.com.br/api
VITE_API_URL=/api

# Caminho base do site ("/" na raiz do domínio, "/loja/" em subpasta)
VITE_BASE_PATH=/

# Exibe a faixa "Ambiente de demonstração" no topo (true/false)
VITE_DEMO_MODE=true

# Apenas desenvolvimento: para onde o proxy do Vite encaminha /api
VITE_DEV_API_TARGET=http://127.0.0.1:8000
